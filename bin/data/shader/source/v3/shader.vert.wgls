/// v3 顶点着色器 WGSL 版本,与 shader.vert 对齐
/// 使用 WebGPU 原生 Immediates 特性(var<immediate>)对应 Vulkan 的 push_constant:
///   layout(push_constant) uniform PushConsts { PointData _point; }
/// -> var<immediate> _point : PointData
/// immediate 布局与 C++ sizeof(PointData) 对齐:
///   _mvp(mat4,off0) _point(u32,off64) _color(u32,off68), size=80

struct  PointData
{
    _mvp    : mat4x4f,
    _point  : u32,
    _color  : u32,
}

var<immediate> _point : PointData;

struct  VsIn
{
    @location(0) inPos : vec3f,
}

struct  VsOut
{
    @builtin(position) pos : vec4f,
}

@vertex
fn  main(in : VsIn) -> VsOut
{
    var out : VsOut;
    /// 与 GLSL 对齐: gl_Position = _point._mvp * vec4(inPos,1)
    out.pos = _point._mvp * vec4f(in.inPos.xyz, 1.0);

    return out;
}
