/// v3c4 片段着色器 WGSL 版本,与 shader.frag 对齐
/// 原始 GLSL 未使用 push_constant,仅传递插值变量输出颜色。

/// RF_SELECTED = (1<<7) = 128
const RF_SELECTED : u32 = 128u;

fn  isSelected(flag : u32) -> bool
{
    return (flag & RF_SELECTED) != 0u;
}
/// 解包 RGBA8(高字节在 R),与 C++ selectColor 打包一致
fn  unpackColor(c : u32) -> vec4f
{
    return vec4f(
        f32((c >> 24u) & 0xFFu) / 255.0,
        f32((c >> 16u) & 0xFFu) / 255.0,
        f32((c >> 8u)  & 0xFFu) / 255.0,
        f32((c >> 0u)  & 0xFFu) / 255.0);
}

/// 引擎渲染状态(高亮颜色等),与 C++ EngineState 对齐
struct  EngineState
{
    selectColor : u32,
}

/// 引擎全局 UBO(SB_Global,与 C++ FEGlobalUBO 逐字节一致,共 112 字节):
///   UBOSky 96B(偏移 0)+ EngineState 4B,尾部由 uniform 布局规则补齐到 16 字节倍数
/// x=昼夜门控(CPU 统一计算),所有非 UI 材质共用同一份数据
struct  UBOSky
{
    _sunDirection   : vec4f,
    _params         : vec4f,
    _up             : vec4f,
    _cloud          : vec4f,
    _anim           : vec4f,
    _env            : vec4f,
}
struct  EngineGlobalBlock
{
    _sky            : UBOSky,
    _engineState    : EngineState,
}
@group(0) @binding(3) var<uniform> _engineGlobal : EngineGlobalBlock;

struct  FsIn
{
    @location(0) inColor    : vec4f,
    /// flat 插值对应 GLSL 的 `flat in uint`
    /// inFlagBits 用于选中高亮判定
    @location(1) @interpolate(flat) inFlagBits : u32,
}

@fragment
fn  main(in : FsIn) -> @location(0) vec4f
{
    /// 显示空间天空环境门控:与 GLSL 的 skyEnvGainDisplay 一致
    /// LDR 直出材质使用 pow(gate, 1/2.2) 保证夜间压暗观感与 PBR 一致
    let gain = pow(clamp(_engineGlobal._sky._env.x, 0.0, 1.0), 1.0 / 2.2);

    /// 选中高亮:与高亮色混合
    if (isSelected(in.inFlagBits))
    {
        let hl  = unpackColor(_engineGlobal._engineState.selectColor);
        let rgb = mix(in.inColor.rgb, hl.rgb, vec3f(0.5));
        return vec4f(rgb * gain, in.inColor.a);
    }
    return vec4f(in.inColor.rgb * gain, in.inColor.a);
}
