/// v3c4 顶点着色器 WGSL 版本,与 shader.vert 对齐
/// 实例参数: intPart(整数平移)/trans(小数平移)/scale/rot(四元数)
/// local 矩阵必须使用 makeOffsetLocalMatrix(带偏移)计算,减少大坐标误差。

struct  CameraData
{
    _v          : mat4x4f,
    _p          : mat4x4f,
    _vp         : mat4x4f,
    _offsetVp   : mat4x4f,
    _decimal    : vec4f,
    _offset     : vec4i,
    _upDir      : vec4f,
    _rightDir   : vec4f,
}

@group(0) @binding(0) var<uniform> _camera : CameraData;

/// RF_COLOR = C++ RenderFlag::RF_COLOR = RF_RECV_LIGHTING<<1 = 16
const RF_COLOR : u32 = 16u;

/// 大坐标处理:用 (intPart - cameraOffset) 抵消相机整数偏移,
/// 平移部分只保留小数量级数值,减少大坐标下的浮点误差
fn  makeOffsetLocalMatrix(t : vec3f, s : vec3f, q : vec4f, intPart : vec3i, cameraOffset : vec3i) -> mat4x4f
{
    let offsetTrans = t + vec3f(intPart - cameraOffset);
    return mat4x4f(
        vec4f(s.x * (1.0 - 2.0 * q.y * q.y - 2.0 * q.z * q.z), s.x * (2.0 * q.x * q.y + 2.0 * q.w * q.z), s.x * (2.0 * q.x * q.z - 2.0 * q.w * q.y), 0.0),
        vec4f(s.y * (2.0 * q.x * q.y - 2.0 * q.w * q.z), s.y * (1.0 - 2.0 * q.x * q.x - 2.0 * q.z * q.z), s.y * (2.0 * q.y * q.z + 2.0 * q.w * q.x), 0.0),
        vec4f(s.z * (2.0 * q.x * q.z + 2.0 * q.w * q.y), s.z * (2.0 * q.y * q.z - 2.0 * q.w * q.x), s.z * (1.0 - 2.0 * q.x * q.x - 2.0 * q.y * q.y), 0.0),
        vec4f(offsetTrans.x, offsetTrans.y, offsetTrans.z, 1.0));
}

struct  VsIn
{
    @location(0) inPos            : vec3f,
    @location(1) inColor          : vec4f,
    @location(2) intPart          : vec3i,
    @location(3) trans            : vec3f,
    @location(4) scale            : vec3f,
    @location(5) rot              : vec4f,
    @location(6) instanceColor    : vec4f,
    @location(7) instanceFlagBits : u32,
}

struct  VsOut
{
    @location(0) outColor       : vec4f,
    @location(1) @interpolate(flat) flagBits : u32,
    @builtin(position) pos     : vec4f,
}

fn  instColor(flagBits : u32, instanceColor : vec4f) -> vec4f
{
    if ((flagBits & RF_COLOR) == 0u)
    {
        return vec4f(1.0, 1.0, 1.0, 1.0);
    }
    return instanceColor;
}

@vertex
fn  main(in : VsIn) -> VsOut
{
    var out      : VsOut;
    /// 必须使用 makeOffsetLocalMatrix(带偏移)构造 local 矩阵
    let localOffset = makeOffsetLocalMatrix(in.trans, in.scale, in.rot, in.intPart, _camera._offset.xyz);

    out.outColor = in.inColor * instColor(in.instanceFlagBits, in.instanceColor);
    out.flagBits = in.instanceFlagBits;
    out.pos      = _camera._offsetVp * localOffset * vec4f(in.inPos.xyz, 1.0);

    return out;
}
