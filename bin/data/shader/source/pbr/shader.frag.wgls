/// pbr 片段着色器 WGSL 版本,与 shader.frag 对齐
/// 原始 GLSL 使用:
///   layout(binding = SB_Material) uniform PBRBlock { PBRData _pbr; }
///   layout(std140, binding = SB_Light) readonly buffer LightsBlock { LightData _lights[]; }
/// SB_Material = 4, SB_Light = 1
///
/// 关于 PBRData 布局:C++ 端写入完整 PBRData (128 字节) 到 uniform 缓冲区。
/// 但本 shader 仅使用 _emissive 和 _diffuse (偏移 0/16),声明最小结构即可,
/// 避免 std140 与 C++ 原始结构在嵌套子结构上的偏移差异。

struct  PBRData
{
    _emissive   : vec4f,     /// 偏移 0
    _diffuse    : vec4f,     /// 偏移 16
}

@group(0) @binding(4) var<uniform> _pbr : PBRData;

struct  LightData
{
    lightType   : i32,       /// 偏移 0
    r           : f32,       /// 偏移 4
    g           : f32,       /// 偏移 8
    b           : f32,       /// 偏移 12
    x           : f32,       /// 偏移 16
    y           : f32,       /// 偏移 20
    z           : f32,       /// 偏移 24
    radius      : f32,       /// 偏移 28
}
/// WGSL array<LightData> 元素步长 = roundUp(align=4, size=32) = 32,
/// 与 C++ sizeof(LightData)=32 一致。

@group(0) @binding(1) var<storage, read> _lights : array<LightData>;

/// RF_COLOR = (1<<4) = 16
const RF_COLOR : u32 = 16u;
/// RF_SELECTED = (1<<7) = 128
const RF_SELECTED : u32 = 128u;

fn  hasNodeColor(flag : u32) -> bool
{
    return (flag & RF_COLOR) != 0u;
}
fn  isSelected(flag : u32) -> bool
{
    return (flag & RF_SELECTED) != 0u;
}
/// 解包 RGBA8(高字节在 R),与 C++ selectColor 打包一致
fn  unpackColor(c : u32) -> vec4f
{
    return vec4f(
        f32((c >> 24u) & 0xFFu) / 255.0,
        f32((c >> 16u) & 0xFFu) / 255.0,
        f32((c >> 8u)  & 0xFFu) / 255.0,
        f32((c >> 0u)  & 0xFFu) / 255.0);
}

/// 引擎渲染状态(高亮颜色等),与 C++ EngineState 对齐
struct  EngineState
{
    selectColor : u32,
}
@group(0) @binding(5) var<uniform> _engineState : EngineState;

struct  FsIn
{
    @location(0) inPos          : vec3f,
    @location(1) inNor          : vec3f,
    @location(2) inNodeColor    : vec4f,
    @location(3) @interpolate(flat) inFlagBits : u32,
}

@fragment
fn  main(in : FsIn) -> @location(0) vec4f
{
    var fragColor    = vec4f(0.0, 0.0, 0.0, 1.0);
    let diff         = select(_pbr._diffuse.rgb, in.inNodeColor.rgb, hasNodeColor(in.inFlagBits));
    /// arrayLength(&_lights) 返回实际绑定子范围的灯光数(与 GLSL _lights.length() 一致);
    /// C++ 端绑定时只给 count*stride 的 range,WebGPU 后端用该子范围创建 bind group。
    let numLights    = arrayLength(&_lights);
    let norN         = normalize(in.inNor);

    for (var i : u32 = 0u; i < numLights; i = i + 1u)
    {
        let lDir    = vec3f(_lights[i].x, _lights[i].y, _lights[i].z);

        let NdotL   = max(0.1, dot(norN, lDir));
        /// 与 GLSL 对齐:diffuse = diff * NdotL + emissive(不乘 lColor)
        let diffuse = diff * NdotL + _pbr._emissive.rgb;

        fragColor   = vec4f(fragColor.rgb + diffuse, 1.0);
    }

    /// 选中高亮:与高亮色混合
    if (isSelected(in.inFlagBits))
    {
        let hl = unpackColor(_engineState.selectColor);
        return vec4f(mix(fragColor.rgb, hl.rgb, vec3f(0.5)), 1.0);
    }
    return fragColor;
}
