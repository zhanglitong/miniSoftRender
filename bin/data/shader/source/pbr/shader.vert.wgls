/// pbr 顶点着色器 WGSL 版本,与 shader.vert 对齐
/// 实例参数: intPart(整数平移)/trans(小数平移)/scale/rot(四元数)
/// 世界位置/法线用 makeTransform(真实坐标),裁剪位置使用
/// makeOffsetLocalMatrix(带偏移)计算,减少大坐标误差。

struct  CameraData
{
    _v          : mat4x4f,
    _p          : mat4x4f,
    _vp         : mat4x4f,
    _offsetVp   : mat4x4f,
    _decimal    : vec4f,
    _offset     : vec4i,
    _upDir      : vec4f,
    _rightDir   : vec4f,
}

@group(0) @binding(0) var<uniform> _camera : CameraData;

/// 由平移/缩放/旋转(四元数)构造 local 矩阵(真实世界坐标)
fn  makeTransform(t : vec3f, s : vec3f, q : vec4f) -> mat4x4f
{
    let pp  = 2.0 * q.xyz * q.yzx;      // 2xy, 2yz, 2zx
    let pw  = 2.0 * q.w   * q.zyx;      // 2wz, 2wy, 2wx
    let dd  = q.xyz * q.xyz;            // xx, yy, zz
    let sum = pp + pw.xzy;              // 2(xy+wz), 2(yz+wx), 2(xz+wy)
    let dif = pp - pw.xzy;              // 2(xy-wz), 2(yz-wx), 2(xz-wy)
    let dg  = vec3f(1.0) - 2.0 * (dd.yzx + dd.zxy);
    return mat4x4f(
        vec4f(vec3f(dg.x, sum.x, dif.z) * s.x, 0.0),
        vec4f(vec3f(dif.x, dg.y, sum.y) * s.y, 0.0),
        vec4f(vec3f(sum.z, dif.y, dg.z) * s.z, 0.0),
        vec4f(t, 1.0));
}

/// 大坐标处理:用 (intPart - cameraOffset) 抵消相机整数偏移
fn  makeOffsetLocalMatrix(t : vec3f, s : vec3f, q : vec4f, intPart : vec3i, cameraOffset : vec3i) -> mat4x4f
{
    return makeTransform(t + vec3f(intPart - cameraOffset), s, q);
}

/// 节点色标志
const RF_COLOR : u32 = 16u;
fn  hasNodeColor(flag : u32) -> bool { return (flag & RF_COLOR) != 0u; }
/// 解包 RGBA8(高字节在 R)
fn  unpackColor(c : u32) -> vec4f
{
    return vec4f(
        f32((c >> 24u) & 0xFFu) / 255.0,
        f32((c >> 16u) & 0xFFu) / 255.0,
        f32((c >> 8u)  & 0xFFu) / 255.0,
        f32((c >> 0u)  & 0xFFu) / 255.0);
}

struct  VsIn
{
    @location(0) inPos      : vec3f,
    @location(1) inNor      : vec3f,
    @location(8) inUV       : vec2f,
    @location(9) inUV1      : vec2f,
    @location(2) intPart    : vec3i,
    @location(3) trans      : vec3f,
    @location(4) scale      : vec3f,
    @location(5) rot        : vec4f,
    @location(6) nodeColor  : vec4f,
    @location(7) flagBits   : u32,
}

struct  VsOut
{
    @location(0) outPos       : vec3f,
    @location(1) outNor       : vec3f,
    @location(2) outUV        : vec2f,
    @location(3) outColor     : vec4f,
    @location(4) @interpolate(flat) outFlagBits : u32,
    /// 第二套 UV(glTF TEXCOORD_1,AO 专用 UV 集等;网格未提供时由零缓冲兜底)
    @location(5) outUV1       : vec2f,
    @builtin(position) pos    : vec4f,
}

@vertex
fn  main(in : VsIn) -> VsOut
{
    var out      : VsOut;
    /// DEBUG: identity transform — bypass instance attributes entirely
    let matLocal = mat4x4f(vec4f(1.0,0.0,0.0,0.0), vec4f(0.0,1.0,0.0,0.0), vec4f(0.0,0.0,1.0,0.0), vec4f(0.0,0.0,0.0,1.0));
    let localOffset = matLocal;

    let tmp      = matLocal * vec4f(in.inPos.xyz, 1.0);
    out.outPos      = tmp.xyz;
    out.outFlagBits = in.flagBits;
    out.outUV       = in.inUV;
    out.outUV1      = in.inUV1;
    out.outColor    = in.nodeColor;
    let mat3Local   = mat3x3f(matLocal[0].xyz, matLocal[1].xyz, matLocal[2].xyz);
    out.outNor      = normalize(mat3Local * in.inNor);
    out.pos         = _camera._offsetVp * localOffset * vec4f(in.inPos.xyz, 1.0);

    return out;
}
