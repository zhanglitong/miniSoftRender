<?xml version="1.0" encoding="utf-8"?>

<!--是否生成默认管线组-->
<root using_defult="1">
  <!--shader-->
  <shaders>
    <shader url =":/data/shader/cache/v3/shader.frag.spv"/>
    <shader url =":/data/shader/cache/v3/shader.vert.spv"/>
</shaders>
  <dynamicStates>
    <VIEWPORT/>
    <SCISSOR/>
    <CULL_MODE/>
    <LINE_WIDTH/>
    <PRIMITIVE_TOPOLOGY/>
    <DEPTH_TEST_ENABLE/>
    <DEPTH_WRITE_ENABLE/>
  </dynamicStates>
  <!--顶点定义: 重要-->
  <bindings>
    <binding binding="0" inputRate="0">
      <input 
          name      = "" 
          location  = "0" 
          slots     = "IS_VERTEX_POS" 
          formats   = "R32G32B32_FLOAT"    
          offsets   = "0"/>
    </binding>
  </bindings>
  <!--支持的特性-->
  <features></features>
  <!--支持的扩展-->
  <extensions></extensions>
  <!--动态状态-->
  <states></states>
</root>
