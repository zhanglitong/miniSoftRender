<?xml version="1.0" encoding="utf-8"?>

<!--是否生成默认管线组-->
<root using_defult="0">
  <!--shader-->
  <shaders>
    <shader url =":/data/shader/cache/point/shader.frag.spv"/>
    <shader url =":/data/shader/cache/point/shader.vert.spv"/>
</shaders>
  <dynamicStates>
    <VIEWPORT/>
    <SCISSOR/>
    <PRIMITIVE_TOPOLOGY/>
  </dynamicStates>
  <!--顶点定义: 重要-->
  <bindings>
    <binding binding="0" inputRate="0">
      <input 
          name      = "" 
          location  = "0" 
          slots     = "IS_VERTEX_POS" 
          formats   = "R32G32B32_FLOAT"    
          offsets   = "0"/>
      <input
          name      = ""
          location  = "1"
          slots     = "IS_VERTEX_COLOR0"
          formats   = "R8G8B8A8_UNORM"
          offsets   = "12"/>
    </binding>
    <binding binding="1" inputRate="1">
      <input
           name      = "intPart"
           location  = "2"
           slots     = "IS_INSTANCE_ITRANSLATE"
           formats   = "R32G32B32_SINT"
           offsets   = "0"/>
      <input
           name      = "trans"
           location  = "3"
           slots     = "IS_INSTANCE_TRANSLATE"
           formats   = "R32G32B32_FLOAT"
           offsets   = "12"/>
      <input
           name      = "scale"
           location  = "4"
           slots     = "IS_INSTANCE_SCALE"
           formats   = "R32G32B32_FLOAT"
           offsets   = "24"/>
      <input
           name      = "rot"
           location  = "5"
           slots     = "IS_INSTANCE_ROTATE"
           formats   = "R32G32B32A32_FLOAT"
           offsets   = "36"/>
    </binding>
  </bindings>
  <!--支持的特性-->
  <features></features>
  <!--支持的扩展-->
  <extensions></extensions>
  <!--动态状态-->
  <states></states>
  <!--自定义配置管线-->
  <pipeline name="point/POINTS">
    <inputAssemblyState>
      <primitive>POINTS</primitive>
    </inputAssemblyState>
  </pipeline>
</root>
